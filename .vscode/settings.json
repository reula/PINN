{
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "env": {
        "PATH": "/Library/TeX/texbin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      },
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ]
    }
  ],
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.rulers": []
  },
  "cSpell.language": "en-US",
  "cSpell.words": [
    "Cederbaum",
    "Chebyshev",
    "Christoffel",
    "DSGNAR",
    "Gauss",
    "Geroch",
    "Hawking",
    "Kretschmann",
    "Legendre",
    "Mendieta",
    "Newton",
    "Petrov",
    "Ricci",
    "Robin",
    "SSBroyden",
    "Schwarzschild",
    "Weyl",
    "autodiff",
    "axisymmetric",
    "harmonically",
    "specref",
    "tanh"
  ]
}
